# Este archivo lo lee SOLO docker compose, para sustituir variables en docker-compose.yml.
#
# La aplicación Java NO lo lee: Spring Boot no tiene soporte para archivos .env.
# Las variables que necesita la aplicación van en el entorno del sistema.
#
# Copiar a .env para desarrollo local. Nunca commitear valores reales.

# Contraseña de PostgreSQL para el contenedor local.
POSTGRES_PASSWORD=opsengine

# --- Lo que sigue NO va acá ---
#
# TYPESAFE_API_KEY y JWT_SECRET los lee la aplicación, así que ponerlos en este archivo
# no tiene efecto. Se configuran en el entorno del usuario:
#
#   setx TYPESAFE_API_KEY "..."
#   setx JWT_SECRET "..."
#
# Hay que abrir una terminal nueva después. En CI van como secretos del repositorio.
